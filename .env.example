# FeedCraft LLM Agent Configuration
# Configurable model (LiteLLM format):
# Examples:
# - gemini/gemini-1.5-flash
# - gemini/gemini-1.5-pro
# - gpt-4o
# - gpt-4o-mini
# - claude-3-5-sonnet-20240620
# - groq/llama-3.1-70b-versatile
DEFAULT_LLM_MODEL=gemini/gemini-1.5-flash

# API Keys (Set the one matching your selected model)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Set to 'true' to run offline without calling real LLM endpoints
MOCK_LLM_MODE=false
